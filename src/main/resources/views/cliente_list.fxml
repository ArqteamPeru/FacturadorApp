<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.facturador.ui.ClienteListController"
      spacing="10"
      alignment="CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Listado de Clientes" style="-fx-font-size: 18px;" />

    <!-- Búsqueda -->
    <TextField fx:id="busquedaField" promptText="Buscar por RUC o Razón Social" prefWidth="400" />

    <TableView fx:id="tablaClientes" prefHeight="300" prefWidth="600">
        <columns>
            <TableColumn text="Tipo Doc" fx:id="colTipoDoc" prefWidth="100"/>
            <TableColumn text="Número Doc" fx:id="colNumeroDoc" prefWidth="150"/>
            <TableColumn text="Razón Social" fx:id="colRazonSocial" prefWidth="200"/>
            <TableColumn text="Dirección" fx:id="colDireccion" prefWidth="150"/>
        </columns>
    </TableView>

    <Button text="Nuevo cliente" onAction="#irAFormulario"/>

    <HBox spacing="20" alignment="CENTER">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Button text="Eliminar seleccionado" onAction="#eliminarSeleccionado"/>
        <Button text="Recargar" onAction="#recargarTabla"/>
    </HBox>

</VBox>
