<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.facturador.ui.ConfiguracionFormController"
            fitToWidth="true">

    <content>
        <VBox spacing="10" alignment="TOP_LEFT">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Configuración del Sistema" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <ComboBox fx:id="comboModo" promptText="Modo (PRUEBA o PRODUCCION)" prefWidth="300"/>

            <Label text="Datos SUNAT:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            <TextField fx:id="txtRuc" promptText="RUC" />
            <TextField fx:id="txtUsuarioSunat" promptText="Usuario SOL" />
            <PasswordField fx:id="txtClaveSunat" promptText="Clave SOL" />

            <Label text="Certificado Digital:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            <HBox spacing="10">
                <TextField fx:id="txtCertificado" promptText="Ruta del certificado" prefWidth="400"/>
                <Button text="Seleccionar" onAction="#seleccionarCertificado"/>
            </HBox>
            <PasswordField fx:id="txtClaveCertificado" promptText="Clave del certificado" />

            <Label text="Datos Empresa:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            <TextField fx:id="txtRazonSocial" promptText="Razón Social" />
            <TextField fx:id="txtDireccion" promptText="Dirección" />
            <TextField fx:id="txtCorreo" promptText="Correo electrónico" />
            <TextField fx:id="txtWeb" promptText="Página web" />

            <Label text="Logo:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            <HBox spacing="10">
                <TextField fx:id="txtLogo" promptText="Ruta del logo" prefWidth="400"/>
                <Button text="Seleccionar" onAction="#seleccionarLogo"/>
            </HBox>

            <Button text="Guardar configuración" onAction="#guardarConfiguracion" />
        </VBox>
    </content>
</ScrollPane>
