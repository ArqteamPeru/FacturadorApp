<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.facturador.ui.SeleccionarProductoController"
      spacing="10" alignment="CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="🛒 Selecciona un producto o servicio"
           style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <TextField fx:id="buscarField"
               promptText="🔍 Buscar por descripción..."
               prefWidth="400"/>

    <TableView fx:id="tablaProductos" prefWidth="700" prefHeight="300">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="80"/>
            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="220"/>
            <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="100"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="120"/>
            <TableColumn fx:id="colAfectacion" text="Afectación IGV" prefWidth="150"/>
        </columns>
    </TableView>

    <Button text="➕ Agregar seleccionado" onAction="#agregarSeleccionado" />
</VBox>
